#!/usr/bin/env bash
# Displays information about a domain's subdomains

domain="$1"
subdomain="$2"

display_record() {
    name="$1"
    answer=$(dig +noall +answer "${name}.${domain}" | awk 'NR == 1 {print $4, $5}')

    record_type=$(printf '%s\n' "$answer" | awk '{print $1}')
    destination=$(printf '%s\n' "$answer" | awk '{print $2}')

    echo "The subdomain ${name} is a ${record_type} record and points to ${destination}"
}

if [ -n "$subdomain" ]; then
    display_record "$subdomain"
else
    for name in www lb-01 web-01 web-02
    do
        display_record "$name"
    done
fi

