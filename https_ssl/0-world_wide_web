#!/usr/bin/env bash
# Display information about domain subdomains.

get_subdomain_info() {
    local domain=$1
    local subdomain=$2
    local full_domain="$subdomain.$domain"

    local result=$(dig "$full_domain" | awk '/ANSWER SECTION:/ {getline; print $4, $5}')
    local record_type=$(echo "$result" | awk '{print $1}')
    local destination=$(echo "$result" | awk '{print $2}')

    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

if [ "$#" -eq 2 ]; then
    get_subdomain_info "$1" "$2"
else
    for subdomain in www lb-01 web-01 web-02; do
        get_subdomain_info "$1" "$subdomain"
    done
fi
